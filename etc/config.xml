<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <hryvinskyi_browser_cache_control>
            <general>
                <enabled>0</enabled>
                <browser_ttl>120</browser_ttl>
                <must_revalidate>1</must_revalidate>
                <excluded_url_patterns>^/(media|static)/</excluded_url_patterns>
            </general>
        </hryvinskyi_browser_cache_control>
    </default>
</config>
