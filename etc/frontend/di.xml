<!--
    Storefront only, on purpose. These are the moments whole-page caching happens at, and Magento registers its
    own page cache plugins in this same area; the admin panel, the web APIs and GraphQL have no full page cache
    behaviour to sit alongside and are deliberately left as they are.

    None of these plugins carries a sort order, and none needs one. What keeps them in the right relationship
    to Magento's own work is which methods they attach to: all three run at points strictly earlier in a request
    than the moment Magento re-checks the visitor's cached context and strips the caching headers when it
    disagrees. That check therefore stays the last word without any ordering being negotiated.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\App\Response\Http">
        <plugin name="hryvinskyi_browser_cache_control_declare_public_response"
                type="Hryvinskyi\BrowserCacheControl\Plugin\DeclarePublicResponse"/>
    </type>

    <type name="Magento\Framework\App\PageCache\Kernel">
        <plugin name="hryvinskyi_browser_cache_control_built_in_cache_stored"
                type="Hryvinskyi\BrowserCacheControl\Plugin\BuiltInCacheStored"/>
        <plugin name="hryvinskyi_browser_cache_control_built_in_cache_served"
                type="Hryvinskyi\BrowserCacheControl\Plugin\BuiltInCacheServed"/>
    </type>
</config>
